# Input/reference data (large, machine/run-specific — not versioned).
# Each person downloads/generates this locally via scripts/install/ and
# scripts/tests/setup_real_smoke_test.sh. If your own data folder (passed
# to scripts/generate_configs.py --data-dir) uses a different name, add it
# here too.
data/
downloads/
test_data/

# Real run configs (machine/experiment-specific — generated by
# scripts/generate_configs.py, never hand-written or committed). Only the
# *.example.csv templates in configs/ are versioned.
configs/*.local.csv

# Outputs generated by grn/ctx runs and their logs
outs/
logs/

# Python
__pycache__/
*.pyc
*.pyo

# Virtual environments (this project uses conda outside the repo, just in case)
.venv/
venv/

# Editor / IDE / OS
.claude/
.vscode/
.idea/
.DS_Store
