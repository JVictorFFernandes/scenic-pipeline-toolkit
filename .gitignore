# Input/reference data (large, machine/run-specific — not versioned).
# Each person downloads/generates this locally via scripts/install/ and
# scripts/tests/setup_real_smoke_test.sh. If your own data folder (passed
# to scripts/generate_configs.py --data-dir) uses a different name, add it
# here too.
data/
downloads/
test_data/

# Everything generated by a real run — config CSVs, logs, and pyscenic's
# own outputs (adj/, regs/) — lives together under
# artifacts/<project>/[<cell-line>/], generated by scripts/generate_configs.py
# and never hand-written or committed. Ignore everything directly under
# artifacts/ EXCEPT artifacts/examples/, which holds tracked, safe-to-share
# templates for the smoke test (see scripts/tests/setup_real_smoke_test.sh).
artifacts/*
!artifacts/examples/

# ...but the smoke test's own generated output/logs under artifacts/examples/
# are still run-specific, so those stay ignored even inside that exception.
artifacts/examples/outs/
artifacts/examples/logs/

# Older layout, kept ignored in case a machine still has one of these from
# before the artifacts/ folder existed.
configs/
outs/
logs/

# Python
__pycache__/
*.pyc
*.pyo

# Virtual environments (this project uses conda outside the repo, just in case)
.venv/
venv/

# Editor / IDE / OS
.claude/
.vscode/
.idea/
.DS_Store
